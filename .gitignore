# ============================================================================
# Weikav MAX102 — 仓库只收录三样东西
# ============================================================================
#
#   1. firmware/   原厂固件 + 已发布的补丁固件
#   2. web/        配置工具（单文件网页 + 设备定义 + 出厂键位）
#   3. dist/       打包好的 exe
#
# 分析文档、反编译产物、脚本、临时文件**一律不入库**。
# 这样 clone 下来只有 1 MB 出头，能直接拿去刷机和用。
#
# 想让分析文档也公开 → 另开一个仓库，别混在这里。
#
# ============================================================================

# ===== 分析文档（不入库）=====
docs/

# ===== 各类脚本 / 工具源码（不入库）=====
tools/
scripts/
patch-sdk/
launcher/
kb/
rea/

# ===== 厂家原始资料包 =====
MAX102json/
MAX102json.zip

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ===== Node（曾用于构建 Web 工具，现不需要）=====
node_modules/
package.json
package-lock.json

# ===== 编辑器 / 系统 =====
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ===== Ghidra / 反编译产物 =====
ghidra_out/
ghidra_proj/
decompiled_all.c
functions.asm
functions.txt
*.gpr
*.rep

# ===== 逻辑分析仪 / 抓包 =====
*.sal
*.sr
*.logicdata
*.pcapng

# ===== 本地临时物 =====
temp/
*.zip
*.tar.gz
wb32-dfu-updater*/
wb_dfu_usb_driver*/
libusb-1.0.dll
openocd*.cfg

# ===== 运行时生成的配置备份（含本机信息）=====
backup_*.json
max102_info.json

# ===== 构建中间产物 =====
dist/_build/
build_exe.cmd
